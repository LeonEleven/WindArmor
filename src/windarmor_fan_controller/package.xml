<?xml version="1.0"?>
<package format="3">
  <name>windarmor_fan_controller</name>
  <version>0.1.0</version>
  <description>ROS 2 dual ducted-fan ESC controller for WindArmor.</description>
  <maintainer email="h-goal@todo.todo">h-goal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>python3-gpiozero</exec_depend>
  <exec_depend>python3-lgpio</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

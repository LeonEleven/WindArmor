<?xml version="1.0"?>
<package format="3">
  <name>windarmor_bringup</name>
  <version>0.3.2</version>
  <description>Unified ROS 2 bringup for the WindArmor robot.</description>
  <maintainer email="elevenlianm@foxmail.com">LeonEleven</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>imu_cybergear_ros2</exec_depend>
  <exec_depend>windarmor_fan_controller</exec_depend>
  <exec_depend>windarmor_flight_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<package format="3">
  <name>imu_cybergear_ros2</name>
  <version>0.3.2</version>
  <description>ROS 2 package for IMU-driven CyberGear motor control with safety watchdog, emergency stop, motor feedback monitoring, and automatic reconnection.</description>
  <maintainer email="user@example.com">imu_cybergear_user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>lifecycle_msgs</depend>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-can</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
